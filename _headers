# Cloudflare Pages headers. Enforces that the browser may only load
# resources from this site's own origin — no third-party requests.
# This is the browser-level backstop for the "no tracking / no wiretapping"
# requirement: even if a third-party script or font were added by mistake,
# the browser would refuse to load it.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN

# Long-cache the immutable, self-hosted fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
